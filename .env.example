# Copy this file to .env and fill in real values. Never commit .env.

# Your Dial API key (starts with sk_live_...)
DIAL_API_KEY=

# The ID of your Dial phone number — NOT the number itself.
# Looks like pn_... — find it on the Phone Numbers page in the Dial
# dashboard (or run `dial number list`).
DIAL_FROM_NUMBER_ID=

# The manager's phone — where the warm-transfer call is placed (E.164, no spaces)
MANAGER_PHONE=+972542299000

# The rep's phone — where the calming one-liner SMS is sent (E.164, no spaces)
REP_PHONE=

# Language of the spoken briefing call (e.g. en-US, he-IL)
DIAL_LANGUAGE=en-US

# Override Dial endpoints only if they differ from the defaults
# (https://getdial.ai/api/v1/calls and https://getdial.ai/api/v1/messages)
DIAL_API_URL=
DIAL_MESSAGES_URL=
