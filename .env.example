# Copy this file to .env and fill in real values. Never commit .env.
DIAL_API_KEY=
# The phone number Dial assigned to your agent (the "from" / caller ID number)
DIAL_FROM_NUMBER=+19086395777
# The manager's phone — where the warm-transfer call is placed (E.164, no spaces)
MANAGER_PHONE=+972542299000
# The rep's phone — where the calming WhatsApp one-liner is sent (E.164, no spaces)
REP_PHONE=
# Dial WhatsApp endpoint (defaults to https://api.dial.com/whatsapp)
WHATSAPP_API_URL=
